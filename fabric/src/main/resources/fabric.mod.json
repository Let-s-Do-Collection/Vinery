{
  "schemaVersion": 1,
  "id": "vinery",
  "version": "${version}",
  "name": "[Let's Do] Vinery",
  "description": "Sun-warmed vineyards, creaking barrels and dusty bottles in a cool cellar. Grow your grapes, press your own wine and build the winery of your dreams.",
  "authors": [
    "satisfy"
  ],
  "contributors": [
    "MissLilitu",
    "CR-055",
    "Jason13Official",
    "Cristelknight",
    "cph101dev",
    "BaumeisterJO"
  ],
  "contact": {
    "sources": "https://github.com/satisfyu/Vinery",
    "issues": "https://github.com/satisfyu/Let-s-Do-Hub",
    "homepage": "https://www.lets-do.ch",
    "wiki": "https://lets-do.ch/wiki/vinery/"
  },
  "license": "Custom",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.satisfy.vinery.fabric.VineryFabric"
    ],
    "client": [
      "net.satisfy.vinery.fabric.client.VineryClientFabric"
    ],
    "rei_client": [
      "net.satisfy.vinery.fabric.core.rei.VineryReiClientPluginFabric"
    ],
    "emi": [
      "net.satisfy.vinery.core.compat.emi.VineryEmiPlugin"
    ],
    "jei_mod_plugin": [
      "net.satisfy.vinery.core.compat.jei.VineryJEIPlugin"
    ],
    "modmenu": [
      "net.satisfy.vinery.fabric.config.ModMenu"
    ]
  },
  "mixins": [
    "vinery-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": "*",
    "minecraft": ">=1.21.1 <1.22",
    "architectury": ">=13.0.8",
    "cloth-config": ">=15.0.140",
    "foundation": ">=1.0.1"
  },
  "conflicts": {
    "copperative": "*",
    "nethervinery": "<1.2.14"
  }
}
